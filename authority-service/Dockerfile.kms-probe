FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/pulpo/authority-service/src

RUN groupadd --system pulpo \
    && useradd --system --gid pulpo --home-dir /nonexistent --shell /usr/sbin/nologin pulpo \
    && mkdir -p /opt/pulpo/authority-service/src/pulpo_authority_service

WORKDIR /opt/pulpo

COPY authority-service/src/pulpo_authority_service/kms_signer.py ./authority-service/src/pulpo_authority_service/kms_signer.py
COPY authority-service/src/pulpo_authority_service/gcp_kms_transport.py ./authority-service/src/pulpo_authority_service/gcp_kms_transport.py
COPY authority-service/src/pulpo_authority_service/kms_probe.py ./authority-service/src/pulpo_authority_service/kms_probe.py

RUN python -m pip install --no-cache-dir \
      'cryptography==50.0.1' \
      'google-cloud-kms==3.16.0' \
    && chown -R pulpo:pulpo /opt/pulpo

USER pulpo

CMD ["python", "-m", "pulpo_authority_service.kms_probe"]
