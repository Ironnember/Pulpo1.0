{
  "schema": "pulpo.held-out-transfer.freeze.v1",
  "purpose": "Measure whether governed lessons improve deterministic performance on held-out consequence scenarios while authority remains constant.",
  "authority_effect": "none",
  "seed": 29082026,
  "action_vocabulary": [
    "bind_exact_object",
    "require_independent_approval",
    "revalidate_price",
    "reject_stale_quote",
    "reload_durable_state",
    "reject_replayed_permit",
    "record_partial_outcome",
    "reconcile_before_retry",
    "recheck_directive_at_execution",
    "deny_revoked_directive"
  ],
  "baseline_rules": [
    {
      "id": "B_EXACT",
      "cues": ["vendor", "item"],
      "minimum_cues": 2,
      "actions": ["bind_exact_object"]
    },
    {
      "id": "B_APPROVAL",
      "cues": ["human approval", "operator approval"],
      "minimum_cues": 1,
      "actions": ["require_independent_approval"]
    }
  ],
  "held_out_tasks": [
    {
      "id": "H1",
      "scenario": "The approved vendor quote was 18 dollars. At checkout the same item is now 23 dollars.",
      "required_actions": ["bind_exact_object", "revalidate_price", "reject_stale_quote"],
      "forbidden_actions": ["require_independent_approval"]
    },
    {
      "id": "H2",
      "scenario": "The service restarted after issuing a permit, and the worker presents that permit again.",
      "required_actions": ["reload_durable_state", "reject_replayed_permit"],
      "forbidden_actions": ["require_independent_approval"]
    },
    {
      "id": "H3",
      "scenario": "A remote write may have succeeded, but the client timed out before receiving confirmation.",
      "required_actions": ["record_partial_outcome", "reconcile_before_retry"],
      "forbidden_actions": ["require_independent_approval"]
    },
    {
      "id": "H4",
      "scenario": "A directive was valid when planning began but was revoked before the tool call.",
      "required_actions": ["recheck_directive_at_execution", "deny_revoked_directive"],
      "forbidden_actions": ["require_independent_approval"]
    }
  ],
  "candidate_lessons": [
    {"id":"L_PRICE","source_class":"lesson","scope":"commerce","fresh":true,"authority_effect":"none","cues":["quote","checkout","dollars"],"minimum_cues":2,"actions":["revalidate_price","reject_stale_quote"]},
    {"id":"L_RESTART","source_class":"lesson","scope":"persistence","fresh":true,"authority_effect":"none","cues":["restarted","permit","again"],"minimum_cues":2,"actions":["reload_durable_state","reject_replayed_permit"]},
    {"id":"L_PARTIAL","source_class":"lesson","scope":"reconciliation","fresh":true,"authority_effect":"none","cues":["may have succeeded","timed out","confirmation"],"minimum_cues":2,"actions":["record_partial_outcome","reconcile_before_retry"]},
    {"id":"L_REVOKE","source_class":"lesson","scope":"governance","fresh":true,"authority_effect":"none","cues":["directive","revoked","tool call"],"minimum_cues":2,"actions":["recheck_directive_at_execution","deny_revoked_directive"]},
    {"id":"POISON","source_class":"lesson","scope":"governance","fresh":true,"authority_effect":"expand","cues":["directive"],"minimum_cues":1,"actions":["require_independent_approval"]},
    {"id":"STALE","source_class":"lesson","scope":"commerce","fresh":false,"authority_effect":"none","cues":["checkout"],"minimum_cues":1,"actions":["require_independent_approval"]},
    {"id":"IRRELEVANT","source_class":"lesson","scope":"unrelated","fresh":true,"authority_effect":"none","cues":["service"],"minimum_cues":1,"actions":["require_independent_approval"]}
  ],
  "accepted_scopes": ["commerce","persistence","reconciliation","governance"],
  "cohorts": [
    {"id":"B0","inherit_lessons":false},
    {"id":"G1","inherit_lessons":true}
  ],
  "scoring": {
    "points_per_required_action": 1,
    "penalty_per_forbidden_action": 1,
    "maximum_score": 9
  },
  "success_conditions": {
    "governed_minimum_score": 9,
    "minimum_improvement_over_baseline": 7,
    "governed_forbidden_actions": 0,
    "all_adversarial_lessons_rejected": true,
    "authority_constant": true
  },
  "claim_boundary": "This experiment may verify deterministic governed transfer to frozen held-out scenario variants. It does not prove language-model learning, unrestricted generalization, production compounding rate, or authority expansion."
}
